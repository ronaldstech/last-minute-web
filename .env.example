# Firebase web configuration (public client configuration).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Set VITE_API_BASE_URL in Vercel to the Hostinger public API URL, for example:
# https://apexspacemw.com/rt/last_minute/backend/public
# Marking uses the API base plus /marking.php unless explicitly overridden.
VITE_API_BASE_URL=
VITE_MARKING_API_URL=

# Use / on Vercel. Keep /rt/last_minute/ when hosting the frontend in that path.
VITE_BASE_PATH=/

# PayChangu mobile money endpoints used by the coin checkout.
VITE_PAYMENT_API_BASE_URL=https://apexspacemw.com/rt/last_minute/paychangu

# Server-side only. Configure this in the PHP host environment; never use a VITE_ prefix.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
