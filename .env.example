# Firebase web configuration (public client configuration).
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Optional API URL overrides. Defaults select local XAMPP in development and
# /rt/last_minute/backend on the deployed site.
VITE_API_BASE_URL=
VITE_MARKING_API_URL=

# PayChangu mobile money endpoints used by the coin checkout.
VITE_PAYMENT_API_BASE_URL=https://apexspacemw.com/rt/last_minute/paychangu

# Server-side only. Configure this in the PHP host environment; never use a VITE_ prefix.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
